# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Ob]j/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get huge, so ignore them by default
/[Mm]emoryCaptures/

# Asset meta data should only be ignored if the Unity project is a package/plugin
# but for standard projects, meta files MUST be tracked!
# !/[Aa]ssets/**/*.meta

# Never ignore generated asset subfolders
!/[Aa]ssets/[Ii]mport/

# Autogenerated Visual Studio / VS Code files
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity Generated Metal/Shader Cache
*[Tt]est[Rr]esults*
/*.aps
/*.sdf
/*.opensdf
/*.VC.db
/ipch/
/ClassDiagram1.diagram
/DerivedData/
*.app/
*.ipa
*.apk
*.unitypackage